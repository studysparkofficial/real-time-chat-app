rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isFullMember() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isDirectRoomId(roomId) {
      return roomId.matches('^dm_.*$');
    }

    function isDirectRoomMember(roomId) {
      let roomPath = /databases/$(database)/documents/rooms/$(roomId);
      return isFullMember()
        && isDirectRoomId(roomId)
        && exists(roomPath)
        && get(roomPath).data.type == 'direct'
        && get(roomPath).data.participants is list
        && get(roomPath).data.participants.hasAny([request.auth.uid]);
    }

    function canReadRoomMessages(roomId) {
      return !isDirectRoomId(roomId) || isDirectRoomMember(roomId);
    }

    // Message validation helpers.
    // Missing fields must be checked with keys() first. Reading a field that
    // was not written (for example text-only messages with no attachment)
    // fails the whole rule and blocks send/receive.
    function isValidText(text) {
      return text == null || (text is string && text.size() <= 10000);
    }

    function hasField(data, field) {
      return field in data;
    }

    function isValidQuietHours(data) {
      return data is map
        && data.keys().hasOnly(['enabled', 'start', 'end', 'timeZone'])
        && data.enabled is bool
        && data.start is string
        && data.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.end is string
        && data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.timeZone is string
        && data.timeZone.size() <= 80;
    }

    function isValidNotificationSettings(data) {
      return data.keys().hasOnly([
          'personalMessages', 'groupMessages', 'mentions', 'replies', 'reactions',
          'voiceCalls', 'videoCalls', 'missedCalls', 'groupAnnouncements',
          'statusNotifications', 'securityNotifications', 'systemNotifications',
          'pushEnabled', 'sounds', 'messagePreviews', 'quietHours'
        ])
        && (!hasField(data, 'personalMessages') || data.personalMessages is bool)
        && (!hasField(data, 'groupMessages') || data.groupMessages is bool)
        && (!hasField(data, 'mentions') || data.mentions is bool)
        && (!hasField(data, 'replies') || data.replies is bool)
        && (!hasField(data, 'reactions') || data.reactions is bool)
        && (!hasField(data, 'voiceCalls') || data.voiceCalls is bool)
        && (!hasField(data, 'videoCalls') || data.videoCalls is bool)
        && (!hasField(data, 'missedCalls') || data.missedCalls is bool)
        && (!hasField(data, 'groupAnnouncements') || data.groupAnnouncements is bool)
        && (!hasField(data, 'statusNotifications') || data.statusNotifications is bool)
        && (!hasField(data, 'securityNotifications') || data.securityNotifications is bool)
        && (!hasField(data, 'systemNotifications') || data.systemNotifications is bool)
        && (!hasField(data, 'pushEnabled') || data.pushEnabled is bool)
        && (!hasField(data, 'sounds') || data.sounds is bool)
        && (!hasField(data, 'messagePreviews') || data.messagePreviews is bool)
        && (!hasField(data, 'quietHours') || isValidQuietHours(data.quietHours));
    }

    function isValidAttachment(att) {
      return att == null || (
        att.key is string
        && att.key.size() > 0
        && att.key.size() <= 1024
        && (!hasField(att, 'size') || (att.size is int && att.size >= 0 && att.size <= 52428800))
        && (!hasField(att, 'fileSize') || (att.fileSize is int && att.fileSize >= 0 && att.fileSize <= 52428800))
      );
    }

    function isValidMentions(data, senderUid) {
      return data is list
        && data.size() <= 10
        && (data.size() == 0 || !data.hasAny([senderUid]));
    }

    // Conversation documents are created only for direct chats. Their message
    // subcollections share the existing room message path so media downloads
    // continue to use the same message-scoped S3 API.
    match /rooms/{roomId} {
      // A transaction may probe a deterministic ID before creating it. An
      // existing direct room remains readable only to its two participants.
      allow get: if isFullMember()
        && (!exists(/databases/$(database)/documents/rooms/$(roomId))
          || isDirectRoomMember(roomId));
      allow list: if isFullMember()
        && resource.data.type == 'direct'
        && resource.data.participants is list
        && resource.data.participants.hasAny([request.auth.uid]);

      allow create: if isFullMember()
        && isDirectRoomId(roomId)
        && request.resource.data.keys().hasOnly([
          'type', 'participants', 'participantInfo', 'createdAt',
          'lastMessage', 'lastMessageAt', 'lastSenderUid'
        ])
        && request.resource.data.type == 'direct'
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participantInfo is map
        && request.resource.data.participantInfo.keys().hasAll(request.resource.data.participants)
        && request.resource.data.createdAt is int
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessageAt is int;

      // Participants can update only the latest-message preview. Membership,
      // participant labels, and creation time remain fixed after creation.
      allow update: if isFullMember()
        && isDirectRoomId(roomId)
        && resource.data.type == 'direct'
        && resource.data.participants is list
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.type == resource.data.type
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.participantInfo == resource.data.participantInfo
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'lastSenderUid'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 180
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastSenderUid == request.auth.uid;

      allow delete: if false;
    }

    // Messages collection under public rooms and participant-only DMs.
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if canReadRoomMessages(roomId);

      // Creating a message: must be from a full (non-guest) authenticated sender
      allow create: if isFullMember()
        && canReadRoomMessages(roomId)
        && hasField(request.resource.data, 'sender')
        && request.resource.data.sender is map
        && hasField(request.resource.data.sender, 'uid')
        && request.resource.data.sender.uid == request.auth.uid
        && (!hasField(request.resource.data, 'text') || isValidText(request.resource.data.text))
        && (!hasField(request.resource.data, 'attachment') || isValidAttachment(request.resource.data.attachment))
        && (!hasField(request.resource.data, 'mentions') || isValidMentions(request.resource.data.mentions, request.auth.uid))
        && (
          (hasField(request.resource.data, 'text')
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0)
          || (hasField(request.resource.data, 'attachment')
            && request.resource.data.attachment != null)
        );

      // Updating a message: allows emoji reactions by any full room member, or editing by owner
      allow update: if isFullMember()
        && canReadRoomMessages(roomId)
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
          resource.data.sender.uid == request.auth.uid
        );

      // Deleting a message: sender only
      allow delete: if isFullMember()
        && canReadRoomMessages(roomId)
        && resource.data.sender.uid == request.auth.uid;
    }

    // Room typing indicators
    match /rooms/{roomId}/typing/{userKey} {
      allow read: if canReadRoomMessages(roomId);
      allow write: if isFullMember() && canReadRoomMessages(roomId) && request.auth.uid == userKey;
    }

    // Only direct-chat participants can see receipts. Each participant may
    // publish only their own last-read marker.
    match /rooms/{roomId}/read_receipts/{userKey} {
      allow read: if isDirectRoomMember(roomId);
      allow create, update: if isDirectRoomMember(roomId)
        && request.auth.uid == userKey
        && request.resource.data.keys().hasOnly(['lastReadAt'])
        && request.resource.data.lastReadAt is timestamp
        && request.resource.data.lastReadAt == request.time;
      allow delete: if false;
    }

    // Per-user read state is private and synced across the user's devices.
    match /user_private/{uid}/dm_state/{conversationId} {
      allow read: if isOwner(uid) && isDirectRoomMember(conversationId);
      allow create, update: if isOwner(uid)
        && isDirectRoomMember(conversationId)
        && request.resource.data.keys().hasOnly(['lastReadAt'])
        && request.resource.data.lastReadAt is timestamp
        && request.resource.data.lastReadAt == request.time;
      allow delete: if isOwner(uid) && isDirectRoomMember(conversationId);
    }

    // Notification records are created only by trusted Cloud Functions.
    // Clients can read their own inbox, mark records read, and remove records.
    match /user_private/{uid}/notifications/{notificationId} {
      allow get, list: if isOwner(uid);
      allow create: if false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
        && request.resource.data.isRead == true
        && request.resource.data.readAt is timestamp
        && request.resource.data.readAt == request.time;
      allow delete: if isOwner(uid);
    }

    match /user_private/{uid}/notification_settings/{settingsId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && settingsId == 'preferences'
        && isValidNotificationSettings(request.resource.data);
      allow delete: if false;
    }

    match /user_private/{uid}/muted_rooms/{roomId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['muted', 'updatedAt'])
        && request.resource.data.muted == true
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // Push endpoints contain device-specific credentials and are callable-only.
    match /user_private/{uid}/push_subscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /user_private/{uid}/notification_events/{eventId} {
      allow read, write: if false;
    }

    match /user_private/{uid}/security_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /user_private/{uid}/call_notification_events/{eventId} {
      allow read, write: if false;
    }

    match /user_private/{uid}/call_rate_limits/{rateId} {
      allow read, write: if false;
    }

    // Minimal profiles power the searchable New Chat picker. Email addresses
    // are intentionally excluded from this public-to-members directory.
    match /user_profiles/{uid} {
      allow read: if isFullMember();
      allow create, update: if isFullMember() && isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'displayNameLower', 'photoURL', 'isAnonymous',
          'status', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.displayNameLower is string
        && request.resource.data.displayNameLower.size() <= 80;
      allow delete: if false;
    }

    // Online users presence
    match /online_users/{userKey} {
      allow read: if true;
      allow write: if isFullMember() && isOwner(userKey);
    }

    // Custom channels
    match /custom_rooms/{roomId} {
      allow read: if true;
      allow create: if isFullMember()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.slug.size() <= 60;
      allow update, delete: if isFullMember()
        && resource.data.createdBy == request.auth.uid;
    }

    // Call Signaling for Voice & Video calls
    match /calls/{callId} {
      allow read: if isFullMember()
        && (resource.data.caller.uid == request.auth.uid || resource.data.recipient.uid == request.auth.uid);
      allow create: if isFullMember()
        && request.resource.data.keys().hasOnly([
          'id', 'conversationId', 'caller', 'recipient', 'callType', 'status',
          'meetingId', 'createdAt', 'answeredAt', 'endedAt', 'endedReason'
        ])
        && request.resource.data.id == callId
        && request.resource.data.caller is map
        && request.resource.data.caller.uid == request.auth.uid
        && request.resource.data.recipient is map
        && request.resource.data.recipient.uid is string
        && request.resource.data.recipient.uid != request.auth.uid
        && request.resource.data.callType in ['voice', 'video']
        && request.resource.data.status in ['ringing', 'initiating']
        && request.resource.data.createdAt is int;
      allow update: if isAuthenticated()
        && (resource.data.caller.uid == request.auth.uid || resource.data.recipient.uid == request.auth.uid)
        && request.resource.data.caller == resource.data.caller
        && request.resource.data.recipient == resource.data.recipient
        && request.resource.data.id == resource.data.id
        && request.resource.data.callType == resource.data.callType
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'meetingId', 'answeredAt', 'endedAt', 'endedReason'
        ])
        && request.resource.data.status in [
          'ringing', 'initiating', 'accepted', 'rejected', 'busy', 'missed', 'ended', 'failed'
        ];
      allow delete: if isAuthenticated()
        && (resource.data.caller.uid == request.auth.uid || resource.data.recipient.uid == request.auth.uid);
    }

    // Call History (stored per user in their private collection)
    match /user_private/{uid}/call_history/{callId} {
      allow read, write: if isOwner(uid);
    }
  }
}
