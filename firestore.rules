rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Message validation helpers
    function isValidText(text) {
      return text is string && text.size() <= 10000;
    }

    function isValidAttachment(att) {
      return att == null || (
        att.key is string
        && att.key.matches('^chats/' + request.auth.uid + '/.*')
        && att.fileSize is int
        && att.fileSize > 0
        && att.fileSize <= 52428800 // 50 MB
        && att.mimeType in [
          'image/jpeg', 'image/png', 'image/webp', 'image/gif',
          'video/mp4', 'video/webm', 'video/quicktime',
          'audio/webm', 'audio/mp4', 'audio/mpeg', 'audio/ogg',
          'application/pdf'
        ]
      );
    }

    // Messages collection under rooms
    match /rooms/{roomId}/messages/{messageId} {
      // Authenticated users can read chat room streams
      allow read: if isAuthenticated();

      // Creating a message: must be from the authenticated sender, no spoofing
      allow create: if isAuthenticated()
        && request.resource.data.sender.uid == request.auth.uid
        && isValidText(request.resource.data.text)
        && isValidAttachment(request.resource.data.attachment)
        && (
          (request.resource.data.text.size() > 0) ||
          (request.resource.data.attachment != null)
        );

      // Updating a message: allows emoji reactions by any room member, or editing by message owner
      allow update: if isAuthenticated()
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
          resource.data.sender.uid == request.auth.uid
        );

      // Deleting a message: sender only
      allow delete: if isAuthenticated()
        && resource.data.sender.uid == request.auth.uid;
    }

    // Room typing indicators
    match /rooms/{roomId}/typing/{userKey} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userKey;
    }

    // Online users presence
    match /online_users/{userKey} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userKey);
    }

    // Custom channels
    match /custom_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.slug.size() <= 40;
      allow update, delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }
  }
}
