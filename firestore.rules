rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isDirectRoomId(roomId) {
      return roomId.matches('^dm_.*$');
    }

    function isDirectRoomMember(roomId) {
      let roomPath = /databases/$(database)/documents/rooms/$(roomId);
      return isAuthenticated()
        && isDirectRoomId(roomId)
        && exists(roomPath)
        && get(roomPath).data.type == 'direct'
        && get(roomPath).data.participants is list
        && get(roomPath).data.participants.hasAny([request.auth.uid]);
    }

    function canReadRoomMessages(roomId) {
      return isAuthenticated()
        && (!isDirectRoomId(roomId) || isDirectRoomMember(roomId));
    }

    // Message validation helpers.
    // Missing fields must be checked with keys() first. Reading a field that
    // was not written (for example text-only messages with no attachment)
    // fails the whole rule and blocks send/receive.
    function isValidText(text) {
      return text == null || (text is string && text.size() <= 10000);
    }

    function hasField(data, field) {
      return data.keys().hasAny([field]);
    }

    function isValidAttachment(att) {
      return att == null || (
        att.key is string
        && att.key.size() > 0
        && att.key.size() <= 1024
        && (!hasField(att, 'size') || (att.size is int && att.size >= 0 && att.size <= 52428800))
        && (!hasField(att, 'fileSize') || (att.fileSize is int && att.fileSize >= 0 && att.fileSize <= 52428800))
      );
    }

    // Conversation documents are created only for direct chats. Their message
    // subcollections share the existing room message path so media downloads
    // continue to use the same message-scoped S3 API.
    match /rooms/{roomId} {
      // A transaction may probe a deterministic ID before creating it. An
      // existing direct room remains readable only to its two participants.
      allow get: if isAuthenticated()
        && (!exists(/databases/$(database)/documents/rooms/$(roomId))
          || isDirectRoomMember(roomId));
      allow list: if isDirectRoomMember(roomId);

      allow create: if isAuthenticated()
        && isDirectRoomId(roomId)
        && request.resource.data.keys().hasOnly([
          'type', 'participants', 'participantInfo', 'createdAt',
          'lastMessage', 'lastMessageAt', 'lastSenderUid'
        ])
        && request.resource.data.type == 'direct'
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participantInfo is map
        && request.resource.data.participantInfo.keys().hasAll(request.resource.data.participants)
        && request.resource.data.createdAt is int
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessageAt is int;

      // Participants can update only the latest-message preview. Membership,
      // participant labels, and creation time remain fixed after creation.
      allow update: if isDirectRoomMember(roomId)
        && request.resource.data.type == resource.data.type
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.participantInfo == resource.data.participantInfo
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'lastSenderUid'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 180
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastSenderUid == request.auth.uid;

      allow delete: if false;
    }

    // Messages collection under public rooms and participant-only DMs.
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if canReadRoomMessages(roomId);

      // Creating a message: must be from the authenticated sender
      allow create: if canReadRoomMessages(roomId)
        && hasField(request.resource.data, 'sender')
        && request.resource.data.sender.uid == request.auth.uid
        && (!hasField(request.resource.data, 'text') || isValidText(request.resource.data.text))
        && (!hasField(request.resource.data, 'attachment') || isValidAttachment(request.resource.data.attachment))
        && (
          (hasField(request.resource.data, 'text')
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0)
          || (hasField(request.resource.data, 'attachment')
            && request.resource.data.attachment != null)
        );

      // Updating a message: allows emoji reactions by any room member, or editing by owner
      allow update: if canReadRoomMessages(roomId)
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) ||
          resource.data.sender.uid == request.auth.uid
        );

      // Deleting a message: sender only
      allow delete: if canReadRoomMessages(roomId)
        && resource.data.sender.uid == request.auth.uid;
    }

    // Room typing indicators
    match /rooms/{roomId}/typing/{userKey} {
      allow read: if canReadRoomMessages(roomId);
      allow write: if canReadRoomMessages(roomId) && request.auth.uid == userKey;
    }

    // Only direct-chat participants can see receipts. Each participant may
    // publish only their own last-read marker.
    match /rooms/{roomId}/read_receipts/{userKey} {
      allow read: if isDirectRoomMember(roomId);
      allow create, update: if isDirectRoomMember(roomId)
        && request.auth.uid == userKey
        && request.resource.data.keys().hasOnly(['lastReadAt'])
        && request.resource.data.lastReadAt is timestamp
        && request.resource.data.lastReadAt == request.time;
      allow delete: if false;
    }

    // Per-user read state is private and synced across the user's devices.
    match /user_private/{uid}/dm_state/{conversationId} {
      allow read: if isOwner(uid) && isDirectRoomMember(conversationId);
      allow create, update: if isOwner(uid)
        && isDirectRoomMember(conversationId)
        && request.resource.data.keys().hasOnly(['lastReadAt'])
        && request.resource.data.lastReadAt is timestamp
        && request.resource.data.lastReadAt == request.time;
      allow delete: if isOwner(uid) && isDirectRoomMember(conversationId);
    }

    // Minimal profiles power the searchable New Chat picker. Email addresses
    // are intentionally excluded from this public-to-members directory.
    match /user_profiles/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'displayNameLower', 'photoURL', 'isAnonymous',
          'status', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.displayNameLower is string
        && request.resource.data.displayNameLower.size() <= 80;
      allow delete: if false;
    }

    // Online users presence
    match /online_users/{userKey} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userKey);
    }

    // Custom channels
    match /custom_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.slug.size() <= 60;
      allow update, delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }
  }
}
