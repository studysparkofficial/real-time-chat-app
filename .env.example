# AWS Configuration for Amazon Chime SDK
AWS_REGION=us-east-1
AWS_CHIME_REGION=us-east-1
AWS_CHIME_MEDIA_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Firebase Configuration
FIREBASE_PROJECT_ID=real-time-chat-app-dbaf1

# Server Port
PORT=3001

# Optional API URL for frontend (leave commented out for local development)
# VITE_CALL_API_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com/prod/calls

# Firebase Cloud Functions / browser push notifications
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
